{
  "name": "recallready",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "worker": "tsx --env-file-if-exists=.env worker/index.ts",
    "db:migrate": "tsx --env-file-if-exists=.env scripts/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=.env scripts/seed.ts",
    "owner:create": "tsx --env-file-if-exists=.env scripts/owner.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test",
    "eval:matching": "tsx scripts/evaluate.ts",
    "eval:extraction": "tsx --env-file-if-exists=.env scripts/evaluate-extraction.ts",
    "demo:verify": "tsx --env-file-if-exists=.env scripts/verify.ts",
    "source:verify": "tsx scripts/source-smoke.ts",
    "demo:record": "tsx --env-file-if-exists=.env scripts/sandbox-evidence.ts",
    "integration:verify": "tsx --env-file-if-exists=.env scripts/integration-preflight.ts"
  },
  "dependencies": {
    "ag-grid-community": "36.3.0",
    "ag-grid-react": "36.3.0",
    "cheerio": "1.2.0",
    "dotenv": "18.0.9",
    "lucide-react": "1.70.0",
    "next": "16.4.5",
    "openai": "7.53.0",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@tailwindcss/postcss": "4.3.5",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.5",
    "jsdom": "29.1.1",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  },
  "type": "module",
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.1"
    }
  }
}
